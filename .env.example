# Runtime connection (Neon pooled URL recommended); include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Direct Neon connection for Prisma migrations; may match DATABASE_URL locally.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Local Vite/Next origins; in Render use the exact public Vercel origins instead.
ALLOWED_URL1=http://localhost:3000
ALLOWED_URL2=http://localhost:3001
NODE_ENV=development
PORT=5000

# Set these only when running `npm run seed:admin`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
