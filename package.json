{
  "name": "blog-api",
  "version": "1.0.0",
  "description": "This is an API for my blog that was made for the odin project",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "seed:admin": "tsx prisma/seed.ts",
    "prismaDeploy": "prisma migrate deploy",
    "prismaGen": "prisma generate",
    "prismaMg": "prisma migrate dev --name init",
    "startRawSql": "prisma generate --sql",
    "watchRawSql": "prisma generate --sql --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChoforJr/blog-api.git"
  },
  "keywords": [],
  "author": "FORSAKANG CHOFOR JUNIOR",
  "license": "",
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/ChoforJr/blog-api/issues"
  },
  "homepage": "https://github.com/ChoforJr/blog-api#readme",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/ws": "^8.18.2",
    "ejs-lint": "^2.0.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
